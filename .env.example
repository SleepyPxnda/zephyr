# Copy to .env and adjust. Defaults match docker/compose.dev.yml.

# --- PostgreSQL ---
POSTGRES_USER=zephyr
POSTGRES_PASSWORD=zephyr
POSTGRES_DB=zephyr
POSTGRES_PORT=5432
DATABASE_URL=postgres://zephyr:zephyr@localhost:5432/zephyr

# --- Object storage (S3-compatible) ---
# External S3, e.g. Hetzner Object Storage (bucket and keys in the Hetzner Console;
# locations fsn1, nbg1, hel1). Other providers work too; most need S3_FORCE_PATH_STYLE=true.
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false

# --- Sessions (nuxt-auth-utils), at least 32 characters ---
NUXT_SESSION_PASSWORD=change-me-to-a-random-string-of-32-chars-or-more

# --- Sign-in with Discord (https://discord.com/developers/applications) ---
# OAuth2 redirect in the Discord app: http://localhost:3000/auth/discord
NUXT_OAUTH_DISCORD_CLIENT_ID=
NUXT_OAUTH_DISCORD_CLIENT_SECRET=
# Discord user id of the super admin (Discord: developer mode → right click → "Copy User ID")
SUPER_ADMIN_DISCORD_ID=
# optional: webhook that announces new access requests in a Discord channel
DISCORD_WEBHOOK_URL=

# --- Production (docker/compose.prod.yml) ---
# port on 127.0.0.1 that your reverse proxy (TLS) forwards to
APP_PORT=3000
# behind a proxy the app sees http: set the public address for Discord, e.g.
# NUXT_OAUTH_DISCORD_REDIRECT_URL=https://zephyr.example.org/auth/discord
NUXT_OAUTH_DISCORD_REDIRECT_URL=

# --- Dev server ---
PORT=3000
# optional: host names the dev server answers to besides localhost, comma separated
# (e.g. a tunnel); for Discord also set the redirect URL: https://<host>/auth/discord
DEV_ALLOWED_HOSTS=
