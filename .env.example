# Copy to .env and adjust. Defaults match docker/compose.dev.yml.

# --- PostgreSQL ---
POSTGRES_USER=zephyr
POSTGRES_PASSWORD=zephyr
POSTGRES_DB=zephyr
POSTGRES_PORT=5432
DATABASE_URL=postgres://zephyr:zephyr@localhost:5432/zephyr

# --- Object storage (MinIO / S3) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=zephyr
S3_ACCESS_KEY=zephyr
S3_SECRET_KEY=zephyr-dev-secret
S3_FORCE_PATH_STYLE=true
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Sessions (nuxt-auth-utils), at least 32 characters ---
NUXT_SESSION_PASSWORD=change-me-to-a-random-string-of-32-chars-or-more

# --- Initial admin account (used by `pnpm db:seed`) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Dev server ---
PORT=3000
