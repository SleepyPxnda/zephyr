{
  "name": "zephyr",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @zephyr/web dev",
    "build": "pnpm --filter @zephyr/web build",
    "lint": "pnpm -r --parallel lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check",
    "test:core": "pnpm --filter @zephyr/core test",
    "db:generate": "pnpm --filter @zephyr/web db:generate",
    "db:migrate": "pnpm --filter @zephyr/web db:migrate",
    "db:seed": "pnpm --filter @zephyr/web db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
