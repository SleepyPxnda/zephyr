{
  "name": "zephyr",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @zephyr/web dev",
    "build": "pnpm --filter @zephyr/web build",
    "lint": "pnpm -r --parallel lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --parallel test",
    "test:e2e": "pnpm --filter @zephyr/e2e test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "poc:fixtures": "pnpm --filter @zephyr/poc-harness fixtures"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
